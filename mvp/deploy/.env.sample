# Sao chep thanh deploy/.env roi sua neu can. Khong dat secret trong file nay.
MVP_VERSION=0.1.0
# Base image pin theo digest (multi-arch index) cua lan chay 10/10/2026:
#   python:3.12-slim  va  nvcr.io/nvidia/tritonserver:25.08-py3 (Triton 2.60.0)
# Doi version: sua tag@digest o day, chay lai `make start` roi `make smoke`; `make digests` in digest dang dung.
PYTHON_IMAGE=python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
TRITON_IMAGE=nvcr.io/nvidia/tritonserver:25.08-py3@sha256:f836551575df7c9fb71144073845c6b3911de57db91a8c95e0687a4d2ac9f7a5
# KIND_CPU cho may khong GPU; KIND_GPU khi host co NVIDIA Container Toolkit (them cau hinh GPU cho service triton).
TRITON_INSTANCE_KIND=KIND_CPU
# Chi mo tren loopback. Doi thanh IP LAN khi can cho may khac goi.
BIND_ADDR=127.0.0.1
INFERENCE_PORT=8443
MANAGEMENT_PORT=9443
