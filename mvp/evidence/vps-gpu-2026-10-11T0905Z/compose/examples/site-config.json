{
  "schema_version": "w2-draft-v1",
  "site_id": "lab-only",
  "station_id": "station-sim",
  "version": "0.1.0",
  "mode": "lab",
  "target": {
    "os": "linux",
    "arch": "amd64"
  },
  "policy": {
    "allowed_purposes": [
      "fixture"
    ],
    "require_signature": false,
    "allowed_preprocess": [
      "tensor-json-v1",
      "image-rgb-unit-v1"
    ],
    "allowed_postprocess": [
      "normalized-score-v1"
    ]
  },
  "runtime_profiles": [
    {
      "name": "reference-cpu-v1",
      "backend": "reference-linear-score-v1",
      "device": "cpu",
      "image_digest": null
    },
    {
      "name": "triton-onnx-gpu-v1",
      "backend": "triton-onnx-v1",
      "device": "nvidia-gpu",
      "image_digest": null
    }
  ],
  "capacity": {
    "cpu_millicores": 2000,
    "ram_mib": 1572,
    "available_vram_mib": 3328,
    "gpu_reserve_mib": 900
  },
  "limits": {
    "max_payload_bytes": 1048576,
    "max_decoded_pixels": 1048576,
    "max_inflight": 1,
    "queue_capacity": 8,
    "request_timeout_ms": 5000
  },
  "retention": {
    "image_days": 1,
    "log_days": 7,
    "audit_days": 30,
    "storage_budget_mib": 128
  },
  "operations": {
    "enable_touch": true,
    "enable_cli": true
  }
}
